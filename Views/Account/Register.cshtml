@model Take_Leave.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    var departments = ViewBag.Departments as List<Take_Leave.Models.Department>;
}

<div class="d-flex justify-content-center" style="padding-top:1.5rem;">
    <div class="section-card" style="max-width:560px; width:100%;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <div style="width:56px; height:56px; border-radius:14px; background:#e8edf9; color:var(--primary); display:flex; align-items:center; justify-content:center; font-size:24px; margin:0 auto 12px;">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1 style="font-size:19px; font-weight:800; color:var(--primary);">Create Staff Account</h1>
                <p style="font-size:12.5px; color:var(--text-muted);">Your account needs admin approval before you can log in</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <form asp-controller="Account" asp-action="Register" method="post" autocomplete="off">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">I am registering as</label>
                        <div class="btn-group w-100" role="group" aria-label="Applicant role">
                            <input type="radio" class="btn-check" name="ApplicantRole" id="roleStaff" value="Staff" autocomplete="off" checked>
                            <label class="btn btn-outline-primary" for="roleStaff"><i class="fas fa-chalkboard-teacher me-1"></i> Teacher / Staff</label>

                            <input type="radio" class="btn-check" name="ApplicantRole" id="roleStudent" value="Student" autocomplete="off">
                            <label class="btn btn-outline-primary" for="roleStudent"><i class="fas fa-user-graduate me-1"></i> Student</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Full Name</label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label id="lblEmployeeId" class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Employee ID <span style="text-transform:none; font-weight:400; color:var(--text-faint);">(optional)</span></label>
                        <input asp-for="EmployeeId" class="form-control" autocomplete="off" data-lpignore="true" data-1p-ignore placeholder="Leave blank if not applicable" />
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Email</label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="username" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label id="lblDepartment" class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Department</label>
                        <select asp-for="DepartmentId" class="form-select" required>
                            <option value="">Select department</option>
                            @if (departments != null)
                            {
                                foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label id="lblDesignation" class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Designation</label>
                        <input asp-for="Designation" class="form-control" autocomplete="organization-title" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Joining Date</label>
                        <input asp-for="JoiningDate" type="date" class="form-control" autocomplete="off" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Password</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 mt-4"><i class="fas fa-paper-plane me-1"></i> Submit Registration</button>
            </form>

            <div class="text-center mt-3" style="font-size:12.5px; color:var(--text-muted);">
                Already have an account? <a asp-action="Login" style="color:var(--primary); font-weight:600;">Login</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var staffRadio = document.getElementById('roleStaff');
            var studentRadio = document.getElementById('roleStudent');
            var lblEmployeeId = document.getElementById('lblEmployeeId');
            var lblDepartment = document.getElementById('lblDepartment');
            var lblDesignation = document.getElementById('lblDesignation');
            var employeeIdInput = document.querySelector('[name="EmployeeId"]');
            var designationInput = document.querySelector('[name="Designation"]');

            function applyLabels(isStudent) {
                lblEmployeeId.innerHTML = isStudent
                    ? 'Roll Number <span style="text-transform:none; font-weight:400; color:var(--text-faint);">(optional)</span>'
                    : 'Employee ID <span style="text-transform:none; font-weight:400; color:var(--text-faint);">(optional)</span>';
                lblDepartment.textContent = isStudent ? 'Program' : 'Department';
                lblDesignation.textContent = isStudent ? 'Semester / Year' : 'Designation';
                employeeIdInput.placeholder = isStudent ? 'e.g. BIT-2023-014' : 'Leave blank if not applicable';
                designationInput.placeholder = isStudent ? 'e.g. 5th Semester' : '';
            }

            staffRadio.addEventListener('change', function () { applyLabels(false); });
            studentRadio.addEventListener('change', function () { applyLabels(true); });
        })();
    </script>
}
