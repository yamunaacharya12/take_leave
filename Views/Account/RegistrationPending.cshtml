@{
    ViewData["Title"] = "Registration Pending";
}

<div class="d-flex justify-content-center" style="padding-top:3rem;">
    <div class="section-card text-center" style="max-width:460px; width:100%;">
        <div class="card-body p-5">
            <div style="width:64px; height:64px; border-radius:50%; background:#fffbeb; color:#b45309; display:flex; align-items:center; justify-content:center; font-size:28px; margin:0 auto 16px;">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <h1 style="font-size:19px; font-weight:800; color:var(--primary);">Registration Submitted</h1>
            <p style="font-size:13px; color:var(--text-muted); margin-top:8px;">
                Your account has been created and is now waiting for admin approval.
                You'll be able to log in once it's approved.
            </p>
            <a asp-action="Login" class="btn btn-primary mt-3"><i class="fas fa-arrow-left me-1"></i> Back to Login</a>
        </div>
    </div>
</div>
