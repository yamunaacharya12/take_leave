@model List<Take_Leave.Models.LeaveRequest>
@{
    ViewData["Title"] = "Team Leaves - Department Head";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-users" style="color:var(--primary);"></i> Team Leaves</h1>
        <p>All leave requests from your department</p>
    </div>
</div>

<div class="section-card">
    <div class="card-header">
        <h2><i class="fas fa-list me-1"></i> All Requests</h2>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table id="teamLeavesTable" class="table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Staff</th>
                            <th>Leave Type</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Days</th>
                            <th>Applied On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var r in Model)
                        {
                            string css = r.Status.ToString() switch
                            {
                                "Approved" => "status-approved",
                                "Rejected" or "RejectedByDepartmentHead" => "status-rejected",
                                "ApprovedByDepartmentHead" => "status-head-approved",
                                _ => "status-pending"
                            };
                            <tr>
                                <td>@i</td>
                                <td class="fw-semibold" style="color:var(--primary);">@r.User?.FullName</td>
                                <td>@r.LeaveType</td>
                                <td>@r.StartDate.ToString("MMM d, yyyy")</td>
                                <td>@r.EndDate.ToString("MMM d, yyyy")</td>
                                <td>@r.TotalDays</td>
                                <td>@r.RequestDate.ToString("MMM d, yyyy")</td>
                                <td><span class="status-badge @css">@r.Status</span></td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                No leave requests from your department yet.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            if ($('#teamLeavesTable tbody tr').length) {
                $('#teamLeavesTable').DataTable({ order: [[6, 'desc']], pageLength: 10 });
            }
        });
    </script>
}
