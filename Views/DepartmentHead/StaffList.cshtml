@model List<Take_Leave.Models.ApplicationUser>
@{
    ViewData["Title"] = "My Staff - Department Head";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-user-friends" style="color:var(--primary);"></i> My Staff</h1>
        <p>Approved staff members in your department</p>
    </div>
</div>

<div class="section-card">
    <div class="card-header">
        <h2><i class="fas fa-list me-1"></i> Staff List</h2>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Employee ID</th>
                            <th>Designation</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td class="fw-semibold" style="color:var(--primary);">@s.FullName</td>
                                <td>@s.EmployeeId</td>
                                <td>@s.Designation</td>
                                <td>
                                    <span class="status-badge @(s.IsActive ? "status-approved" : "status-rejected")">
                                        @(s.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="StaffLeaveHistory" asp-route-userId="@s.Id" class="btn btn-outline-secondary btn-icon"><i class="fas fa-history"></i></a>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                No staff members in your department yet.
            </div>
        }
    </div>
</div>
