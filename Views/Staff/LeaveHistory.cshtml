@model List<Take_Leave.Models.LeaveRequest>
@{
    ViewData["Title"] = "Leave History - Staff";
    int approved = Model?.Count(l => l.Status.ToString() == "Approved") ?? 0;
    int pending = Model?.Count(l => l.Status.ToString() == "Pending") ?? 0;
    int rejected = Model?.Count(l => l.Status.ToString().Contains("Rejected")) ?? 0;
    int total = Model?.Count ?? 0;
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-history" style="color:var(--primary);"></i> Leave History</h1>
        <p>Complete record of all your submitted leave applications</p>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <span class="badge rounded-pill border" style="background:#fff; color:var(--primary); font-weight:600; padding:8px 14px;">@total Total Requests</span>
    <span class="badge rounded-pill border" style="background:#fff; color:#166534; font-weight:600; padding:8px 14px;">@approved Approved</span>
    <span class="badge rounded-pill border" style="background:#fff; color:#b45309; font-weight:600; padding:8px 14px;">@pending Pending</span>
    <span class="badge rounded-pill border" style="background:#fff; color:#991b1b; font-weight:600; padding:8px 14px;">@rejected Rejected</span>
</div>

<div class="section-card">
    <div class="card-header">
        <h2><i class="fas fa-list me-1"></i> All Leave Applications</h2>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table id="historyTable" class="table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Leave Type</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Days</th>
                            <th>Reason</th>
                            <th>Applied On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var r in Model)
                        {
                            string css = r.Status.ToString() switch
                            {
                                "Approved" => "status-approved",
                                "Rejected" or "RejectedByDepartmentHead" => "status-rejected",
                                "ApprovedByDepartmentHead" => "status-head-approved",
                                _ => "status-pending"
                            };
                            <tr>
                                <td>@i</td>
                                <td class="fw-semibold" style="color:var(--primary);">@r.LeaveType</td>
                                <td>@r.StartDate.ToString("MMM d, yyyy")</td>
                                <td>@r.EndDate.ToString("MMM d, yyyy")</td>
                                <td>@r.TotalDays</td>
                                <td>@r.Reason</td>
                                <td>@r.RequestDate.ToString("MMM d, yyyy")</td>
                                <td><span class="status-badge @css">@r.Status</span></td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-folder-open"></i>
                You haven't submitted any leave applications yet.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            if ($('#historyTable tbody tr').length) {
                $('#historyTable').DataTable({ order: [[6, 'desc']], pageLength: 10 });
            }
        });
    </script>
}
