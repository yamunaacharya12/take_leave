@model Take_Leave.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile - Staff";
    var departments = ViewBag.Departments as List<Take_Leave.Models.Department>;
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-user" style="color:var(--primary);"></i> My Profile</h1>
        <p>View and manage your personal information</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle me-1"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-1"></i> @TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="section-card h-100">
            <div class="card-body text-center">
                <div style="width:96px; height:96px; border-radius:50%; background:linear-gradient(135deg,#e8edf9,#dbe4fb); color:var(--primary); display:flex; align-items:center; justify-content:center; font-size:34px; margin:0 auto; border:3px solid #fff; box-shadow:0 4px 14px rgba(26,58,110,.12);">
                    <i class="fas fa-user"></i>
                </div>
                <div class="fw-bold mt-3" style="font-size:17px; color:var(--primary);">@Model.FullName</div>
                <div style="font-size:12.5px; color:var(--text-muted);">@Model.Designation</div>
                <span class="status-badge @(Model.IsActive ? "status-approved" : "status-rejected") mt-2 d-inline-block">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>

                <hr class="my-3" />

                <div class="text-start" style="font-size:13px;">
                    <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted"><i class="fas fa-id-card me-1" style="width:14px;"></i>Employee ID</span><span class="fw-semibold">@Model.EmployeeId</span></div>
                    <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted"><i class="fas fa-building me-1" style="width:14px;"></i>Department</span><span class="fw-semibold">@(Model.Department?.Name ?? "—")</span></div>
                    <div class="d-flex justify-content-between py-2"><span class="text-muted"><i class="fas fa-calendar me-1" style="width:14px;"></i>Joined</span><span class="fw-semibold">@Model.JoiningDate.ToString("MMM yyyy")</span></div>
                </div>

                <hr class="my-3" />

                <div class="fw-bold text-start mb-2" style="font-size:13px; color:var(--primary);">Leave Balance</div>
                <div class="row g-2 text-start">
                    <div class="col-4">
                        <div class="p-2 rounded" style="background:#f8fafc;">
                            <div style="font-size:16px; font-weight:800; color:var(--primary);">@Model.AnnualLeaveBalance</div>
                            <div style="font-size:10px; color:var(--text-faint);">Annual</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded" style="background:#f8fafc;">
                            <div style="font-size:16px; font-weight:800; color:var(--accent);">@Model.SickLeaveBalance</div>
                            <div style="font-size:10px; color:var(--text-faint);">Sick</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded" style="background:#f8fafc;">
                            <div style="font-size:16px; font-weight:800; color:#b45309;">@Model.EmergencyLeaveBalance</div>
                            <div style="font-size:10px; color:var(--text-faint);">Emergency</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="section-card mb-3">
            <div class="card-header">
                <h2><i class="fas fa-pen me-1"></i> Edit Personal Information</h2>
            </div>
            <div class="card-body">
                <form asp-controller="Staff" asp-action="UpdateProfile" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-user" style="color:var(--text-faint);"></i></span>
                                <input asp-for="FullName" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-envelope" style="color:var(--text-faint);"></i></span>
                                <input value="@Model.Email" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Employee ID</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-hashtag" style="color:var(--text-faint);"></i></span>
                                <input value="@Model.EmployeeId" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Designation</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-id-badge" style="color:var(--text-faint);"></i></span>
                                <input asp-for="Designation" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Department</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-building" style="color:var(--text-faint);"></i></span>
                                <select name="DepartmentId" class="form-select">
                                    @if (departments != null)
                                    {
                                        foreach (var d in departments)
                                        {
                                            <option value="@d.Id" selected="@(d.Id == Model.DepartmentId)">@d.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-map-marker-alt" style="color:var(--text-faint);"></i></span>
                                <input asp-for="Address" class="form-control" placeholder="e.g. Kathmandu, Nepal" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Save Changes</button>
                        <button type="reset" class="btn btn-outline-secondary">Cancel</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="section-card">
            <div class="card-header">
                <h2><i class="fas fa-lock me-1"></i> Change Password</h2>
            </div>
            <div class="card-body">
                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Current Password</label>
                            <div class="input-group">
                                <input type="password" name="CurrentPassword" class="form-control pwd-field" required />
                                <button type="button" class="btn btn-outline-secondary js-toggle-pwd"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">New Password</label>
                            <div class="input-group">
                                <input type="password" name="NewPassword" class="form-control pwd-field" minlength="6" required />
                                <button type="button" class="btn btn-outline-secondary js-toggle-pwd"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Confirm Password</label>
                            <div class="input-group">
                                <input type="password" name="ConfirmPassword" class="form-control pwd-field" minlength="6" required />
                                <button type="button" class="btn btn-outline-secondary js-toggle-pwd"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-accent"><i class="fas fa-key me-1"></i> Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.js-toggle-pwd').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var input = btn.closest('.input-group').querySelector('.pwd-field');
                var icon = btn.querySelector('i');
                var showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                icon.classList.toggle('fa-eye', showing);
                icon.classList.toggle('fa-eye-slash', !showing);
            });
        });
    </script>
}
