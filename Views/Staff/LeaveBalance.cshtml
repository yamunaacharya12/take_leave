@model Take_Leave.Models.ApplicationUser
@{
    ViewData["Title"] = "Leave Balance - Staff";
    var balances = new[]
    {
        new { Name = "Annual Leave", Remaining = Model.AnnualLeaveBalance, Total = 20, Icon = "fa-calendar-alt", Css = "navy" },
        new { Name = "Sick Leave", Remaining = Model.SickLeaveBalance, Total = 12, Icon = "fa-notes-medical", Css = "pink" },
        new { Name = "Emergency Leave", Remaining = Model.EmergencyLeaveBalance, Total = 5, Icon = "fa-exclamation-circle", Css = "gold" },
    };
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-balance-scale" style="color:var(--primary);"></i> Leave Balance</h1>
        <p>Your current leave entitlements and remaining days</p>
    </div>
</div>

<div class="row g-3">
    @foreach (var b in balances)
    {
        int used = b.Total - b.Remaining;
        int pct = b.Total > 0 ? (int)((double)used / b.Total * 100) : 0;
        <div class="col-md-4">
            <div class="stat-card @b.Css">
                <div class="accent-bar"></div>
                <div class="d-flex justify-content-between align-items-start">
                    <div class="fw-bold" style="font-size:14px; color:var(--primary);">@b.Name</div>
                    <div class="icon-wrap" style="width:32px;height:32px;margin-bottom:0;"><i class="fas @b.Icon"></i></div>
                </div>
                <div style="font-size:28px; font-weight:800; color:var(--text-main); margin-top:8px;">@b.Remaining <span style="font-size:13px; color:var(--text-faint); font-weight:500;">/ @b.Total days</span></div>
                <div class="balance-progress">
                    <div class="fill" style="width:@(pct)%; background:var(--accent);"></div>
                </div>
                <div style="font-size:11px; color:var(--text-faint); margin-top:6px;">@used days used this year</div>
            </div>
        </div>
    }
</div>

<div class="alert alert-info mt-3" style="font-size:12.5px;">
    <i class="fas fa-info-circle me-1"></i>
    Balances update automatically whenever a leave request is approved.
</div>
