@model Take_Leave.Models.Notice
@{
    ViewData["Title"] = "Edit Notice";
    var departments = ViewBag.Departments as List<Take_Leave.Models.Department>;
    var selectedIds = ViewBag.SelectedDepartmentIds as List<int> ?? new List<int>();
}

<div class="d-flex justify-content-center" style="padding-top:1.5rem;">
    <div class="section-card" style="max-width:640px; width:100%;">
        <div class="card-body p-4">
            <h1 style="font-size:19px; font-weight:800; color:var(--primary);" class="mb-3">
                <i class="fas fa-edit me-1"></i> Edit Notice
            </h1>

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <form asp-controller="Notice" asp-action="Edit" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Subject</label>
                    <input type="text" name="Subject" class="form-control" value="@Model.Subject" required maxlength="200" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Content</label>
                    <textarea name="Content" class="form-control" rows="6" required>@Model.Content</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Post To</label>
                    <p style="font-size:11.5px; color:var(--text-faint); margin-top:-4px; margin-bottom:8px;">
                        Select one or more departments/offices. Leave all unchecked to post to everyone.
                    </p>

                    <div class="border rounded p-3" style="max-height:220px; overflow-y:auto;">
                        <div class="row g-2">
                            @if (departments != null && departments.Any())
                            {
                                foreach (var d in departments)
                                {
                                    bool isChecked = selectedIds.Contains(d.Id);
                                    <div class="col-md-4 col-sm-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="DepartmentIds" value="@d.Id" id="edit-dept-@d.Id" checked="@isChecked" />
                                            <label class="form-check-label" for="edit-dept-@d.Id" style="font-size:13.5px;">@d.Name</label>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0" style="font-size:13px;">No departments found. Add departments first from the Departments page.</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary flex-grow-1"><i class="fas fa-save me-1"></i> Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
