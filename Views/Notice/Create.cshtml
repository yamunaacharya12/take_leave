@{
    ViewData["Title"] = "Post Notice";
    var departments = ViewBag.Departments as List<Take_Leave.Models.Department>;
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-plus-circle" style="color:var(--primary);"></i> Post a Notice</h1>
        <p>Broadcast an announcement to staff</p>
    </div>
</div>

<div class="section-card">
    <div class="card-header">
        <h2><i class="fas fa-bullhorn me-1"></i> Notice Details</h2>
    </div>
    <div class="card-body">
        <form asp-controller="Notice" asp-action="Create" method="post">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Subject</label>
                    <input type="text" name="Subject" class="form-control" required maxlength="200" />
                </div>

                <div class="col-12">
                    <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Post To</label>
                    <p style="font-size:11.5px; color:var(--text-faint); margin-top:-4px; margin-bottom:8px;">
                        Select one or more departments/offices. Leave all unchecked to post to everyone.
                    </p>

                    <div class="border rounded p-3" style="max-height:220px; overflow-y:auto;">
                        <div class="row g-2">
                            @if (departments != null && departments.Any())
                            {
                                foreach (var d in departments)
                                {
                                    <div class="col-md-4 col-sm-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="DepartmentIds" value="@d.Id" id="dept-@d.Id" />
                                            <label class="form-check-label" for="dept-@d.Id" style="font-size:13.5px;">@d.Name</label>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0" style="font-size:13px;">No departments found. Add departments first from the Departments page.</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label" style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Content</label>
                    <textarea name="Content" class="form-control" rows="5" required></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane me-1"></i> Broadcast Notice</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
