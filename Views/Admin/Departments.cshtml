@model List<Take_Leave.Models.Department>
@{
    ViewData["Title"] = "Departments - Admin";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-building" style="color:var(--primary);"></i> Departments</h1>
        <p>Configure the college's core functional units</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createDeptModal">
        <i class="fas fa-plus me-1"></i> New Department
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var d in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="stat-card navy h-100">
                    <div class="accent-bar"></div>
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="icon-wrap"><i class="fas fa-building"></i></div>
                        <span class="status-badge @(d.IsActive ? "status-approved" : "status-rejected")">
                            @(d.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    <div class="fw-bold" style="font-size:16px; color:var(--primary); margin-top:8px;">@d.Name</div>
                    @if (!string.IsNullOrWhiteSpace(d.Description))
                    {
                        <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">@d.Description</div>
                    }
                    <div style="font-size:12.5px; color:var(--text-muted); margin-top:4px;">
                        <i class="fas fa-user-tie me-1"></i> Head: @(d.HeadUser?.FullName ?? "Not assigned")
                    </div>
                    <div style="font-size:11px; color:var(--text-faint); margin-top:6px;">Created @d.CreatedDate.ToString("MMM yyyy")</div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="button"
                                class="btn btn-sm btn-outline-warning flex-grow-1 dept-edit-btn"
                                data-id="@d.Id"
                                data-name="@d.Name"
                                data-description="@d.Description">
                            <i class="fas fa-edit me-1"></i> Edit
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary flex-grow-1 dept-assign-head-btn"
                                data-id="@d.Id"
                                data-name="@d.Name"
                                data-current-head-id="@d.HeadUserId">
                            <i class="fas fa-user-tie me-1"></i> Assign Head
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger dept-delete-btn"
                                data-id="@d.Id"
                                data-name="@d.Name">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="empty-state">
                <i class="fas fa-building"></i>
                No departments configured yet.
            </div>
        </div>
    }
</div>

<!-- Create Department Modal -->
<div class="modal fade" id="createDeptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:14px;">
            <form asp-action="CreateDepartment" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" style="color:var(--primary); font-weight:700;">New Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" style="font-size:11.5px; font-weight:700; text-transform:uppercase;">Department Name</label>
                    <input type="text" name="Name" class="form-control mb-3" required />

                    <label class="form-label" style="font-size:11.5px; font-weight:700; text-transform:uppercase;">Description (optional)</label>
                    <textarea name="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Department Modal -->
<div class="modal fade" id="editDeptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:14px;">
            <form asp-action="EditDepartment" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" style="color:var(--primary); font-weight:700;">Edit Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="editDeptId" value="" />

                    <label class="form-label" style="font-size:11.5px; font-weight:700; text-transform:uppercase;">Department Name</label>
                    <input type="text" name="Name" id="editDeptName" class="form-control mb-3" required />

                    <label class="form-label" style="font-size:11.5px; font-weight:700; text-transform:uppercase;">Description (optional)</label>
                    <textarea name="Description" id="editDeptDescription" class="form-control" rows="2"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Assign Head Modal -->
<div class="modal fade" id="assignHeadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-header">
                <h5 class="modal-title" style="color:var(--primary); font-weight:700;">
                    Assign Head — <span id="assignHeadDeptName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" style="font-size:11.5px; font-weight:700; text-transform:uppercase;">Select Staff Member</label>
                <select id="assignHeadUserSelect" class="form-select">
                    <option value="">Loading staff...</option>
                </select>
                <p style="font-size:11.5px; color:var(--text-faint); margin-top:8px;">
                    Assigning a new head automatically promotes them to the Department Head role, and demotes the previous head (if any) back to Staff.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="assignHeadConfirmBtn" class="btn btn-primary">Assign Head</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Department Confirmation Modal -->
<div class="modal fade" id="deleteDeptModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;">
            <div class="modal-body text-center p-4">
                <div style="width:56px; height:56px; border-radius:14px; background:#fef2f2; color:#dc2626; display:flex; align-items:center; justify-content:center; font-size:24px; margin:0 auto 14px;">
                    <i class="fas fa-trash"></i>
                </div>
                <h5 class="mb-2">Delete this department?</h5>
                <p style="font-size:13.5px; color:var(--text-muted);" class="mb-1">
                    "<span id="deleteDeptName" class="fw-bold"></span>" will be permanently removed.
                </p>
                <p style="font-size:12.5px; color:var(--text-faint);" class="mb-4">
                    This only works if no staff are currently assigned to it. This action cannot be undone.
                </p>

                <form id="deleteDeptForm" asp-action="DeleteDepartment" method="post" class="d-flex gap-2 justify-content-center">
                    <input type="hidden" id="deleteDeptId" name="id" value="" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-1"></i> Delete Department</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            // ----- Edit Department -----
            document.querySelectorAll('.dept-edit-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    document.getElementById('editDeptId').value = btn.dataset.id;
                    document.getElementById('editDeptName').value = btn.dataset.name;
                    document.getElementById('editDeptDescription').value = btn.dataset.description || '';

                    var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editDeptModal'));
                    modal.show();
                });
            });

            // ----- Assign Head -----
            var assignHeadModalEl = document.getElementById('assignHeadModal');
            var assignHeadModal = bootstrap.Modal.getOrCreateInstance(assignHeadModalEl);
            var currentDeptId = null;

            document.querySelectorAll('.dept-assign-head-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    currentDeptId = btn.dataset.id;
                    document.getElementById('assignHeadDeptName').textContent = btn.dataset.name;

                    var select = document.getElementById('assignHeadUserSelect');
                    select.innerHTML = '<option value="">Loading staff...</option>';

                    fetch('/Admin/GetEligibleStaff')
                        .then(function(res) { return res.json(); })
                        .then(function(staff) {
                            select.innerHTML = '<option value="">-- Select staff member --</option>';
                            staff.forEach(function(s) {
                                var opt = document.createElement('option');
                                opt.value = s.id;
                                opt.textContent = s.fullName;
                                if (btn.dataset.currentHeadId && s.id === btn.dataset.currentHeadId) {
                                    opt.selected = true;
                                }
                                select.appendChild(opt);
                            });
                        })
                        .catch(function() {
                            select.innerHTML = '<option value="">Failed to load staff list</option>';
                        });

                    assignHeadModal.show();
                });
            });

            document.getElementById('assignHeadConfirmBtn').addEventListener('click', function() {
                var userId = document.getElementById('assignHeadUserSelect').value;
                if (!userId || !currentDeptId) {
                    alert('Please select a staff member.');
                    return;
                }

                var btn = this;
                btn.disabled = true;
                btn.textContent = 'Assigning...';

                var formData = new URLSearchParams();
                formData.append('departmentId', currentDeptId);
                formData.append('userId', userId);

                fetch('/Admin/AssignDepartmentHead', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString()
                })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert(data.message || 'Failed to assign department head.');
                            btn.disabled = false;
                            btn.textContent = 'Assign Head';
                        }
                    })
                    .catch(function() {
                        alert('An error occurred. Please try again.');
                        btn.disabled = false;
                        btn.textContent = 'Assign Head';
                    });
            });

            // ----- Delete Department -----
            document.querySelectorAll('.dept-delete-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    document.getElementById('deleteDeptId').value = btn.dataset.id;
                    document.getElementById('deleteDeptName').textContent = btn.dataset.name;

                    var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteDeptModal'));
                    modal.show();
                });
            });
        })();
    </script>
}
