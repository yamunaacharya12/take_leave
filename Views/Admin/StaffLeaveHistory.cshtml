@model List<Take_Leave.Models.LeaveRequest>

@{
    ViewData["Title"] = "Staff Leave History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="m-0 text-dark fw-bold" style="font-size: 1.4rem;">
            <i class="fas fa-calendar-alt me-2 text-accent"></i>Leave History — @ViewBag.StaffName
        </h2>
        <a asp-action="StaffList" class="btn btn-sm btn-light border px-3 shadow-sm">
            <i class="fas fa-arrow-left me-1 text-secondary"></i> Back to Staff List
        </a>
    </div>

    <div class="section-card shadow-sm">
        <div class="card-header">
            <h2 class="m-0">
                <i class="fas fa-history me-2 text-accent"></i>Leave Requests Ledger for @ViewBag.StaffName (@ViewBag.StaffId)
            </h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small" id="leaveTable">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="border-0 ps-3" style="width: 15%;">Leave Type Category</th>
                            <th class="border-0" style="width: 15%;">Start Date</th>
                            <th class="border-0" style="width: 15%;">End Date</th>
                            <th class="border-0 text-center" style="width: 8%;">Days</th>
                            <th class="border-0" style="width: 24%;">Reason Justification</th>
                            <th class="border-0" style="width: 12%;">Workflow State</th>
                            <th class="border-0 pe-3" style="width: 11%;">Submission</th>
                        </tr>
                    </thead>
                    <tbody class="text-dark">
                        @foreach (var leave in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    <span class="badge bg-light text-dark border px-2 py-1">@leave.LeaveType</span>
                                </td>
                                <td>@leave.StartDate.ToString("MMM dd, yyyy")</td>
                                <td>@leave.EndDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-center fw-bold text-secondary">@leave.TotalDays</td>
                                <td class="text-muted text-truncate" style="max-width: 220px;" title="@leave.Reason">@leave.Reason</td>
                                <td>
                                    @if (leave.Status == LeaveStatus.Approved)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded-1 tracking-wider fw-bold text-uppercase" style="font-size: 0.7rem;">Approved</span>
                                    }
                                    else if (leave.Status == LeaveStatus.Rejected)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5 rounded-1 tracking-wider fw-bold text-uppercase" style="font-size: 0.7rem;">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-0.5 rounded-1 tracking-wider fw-bold text-uppercase" style="font-size: 0.7rem;">Pending</span>
                                    }
                                </td>
                                <td class="text-muted small pe-3">@leave.RequestDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
        $('#leaveTable').DataTable({
        "pageLength": 10,
        "order": [[1, "desc"]],
        "dom": '<"p-3 d-flex justify-content-between align-items-center bg-light border-bottom"<"small"l><"small"f>>rt<"p-3 d-flex justify-content-between align-items-center border-top small"<"text-muted"i><"pagination-sm"p>>',
        "language": {
        "search": "_INPUT_",
        "searchPlaceholder": "Search statements...",
        "lengthMenu": "Display _MENU_ records",
        "info": "Displaying _START_ to _END_ of _TOTAL_ entries"
        }
        });
        });
    </script>
}