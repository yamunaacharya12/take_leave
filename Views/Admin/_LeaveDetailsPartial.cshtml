@model Take_Leave.Models.LeaveRequest

@if (Model != null)
{
    <!-- Workflow Processing Status Badge Header -->
    <div class="text-center mb-4">
        @{
            var statusClass = Model.Status == Take_Leave.Models.LeaveStatus.Approved ? "success" :
                              Model.Status == Take_Leave.Models.LeaveStatus.Rejected ? "danger" :
                              Model.Status == Take_Leave.Models.LeaveStatus.ApprovedByDepartmentHead ? "info" : "warning";

            var statusIcon = Model.Status == Take_Leave.Models.LeaveStatus.Approved ? "check-circle" :
                                         Model.Status == Take_Leave.Models.LeaveStatus.Rejected ? "times-circle" :
                                         Model.Status == Take_Leave.Models.LeaveStatus.ApprovedByDepartmentHead ? "user-check" : "clock";

            var statusLabel = Model.Status == Take_Leave.Models.LeaveStatus.ApprovedByDepartmentHead ? "Approved by Department Head" : Model.Status.ToString();
        }
        <span class="badge bg-@statusClass-subtle text-@statusClass px-3 py-2 rounded-1 border border-@statusClass-subtle tracking-wider fw-bold text-uppercase" style="font-size: 0.8rem;">
            <i class="fas fa-@statusIcon me-1"></i> Status: @statusLabel
        </span>
    </div>

    <div class="row g-4">
        <!-- Section: Employee Profile Summary -->
        <div class="col-md-12">
            <div class="section-card shadow-sm">
                <div class="card-header">
                    <h2 class="m-0">
                        <i class="fas fa-user me-2 text-accent"></i>Employee Information
                    </h2>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <table class="table table-borderless align-middle mb-0 small">
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0" style="width: 35%;">Employee Name:</th>
                                    <td class="text-dark"><span class="fw-bold">@Model.User?.FullName</span> <span class="text-muted">(@Model.User?.EmployeeId)</span></td>
                                </tr>
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0">Department:</th>
                                    <td class="text-dark">@Model.User?.Department</td>
                                </tr>
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0">Designation:</th>
                                    <td class="text-muted">@Model.User?.Designation</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless align-middle mb-0 small">
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0" style="width: 35%;">Email Address:</th>
                                    <td><a href="mailto:@Model.User?.Email" class="text-decoration-none text-primary fw-medium">@Model.User?.Email</a></td>
                                </tr>
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0">Joining Date:</th>
                                    <td class="text-dark">@Model.User?.JoiningDate.ToString("MMMM dd, yyyy")</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Detailed Leave Metrics -->
        <div class="col-md-12">
            <div class="section-card shadow-sm">
                <div class="card-header">
                    <h2 class="m-0">
                        <i class="fas fa-calendar-alt me-2 text-accent"></i>Leave Request Specifications
                    </h2>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <table class="table table-borderless align-middle mb-0 small">
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0" style="width: 35%;">Leave Category:</th>
                                    <td><span class="badge bg-light text-dark border px-2 py-1 fw-semibold">@Model.LeaveType</span></td>
                                </tr>
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0">Start Date:</th>
                                    <td class="text-dark fw-medium">@Model.StartDate.ToString("dddd, MMMM dd, yyyy")</td>
                                </tr>
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0">End Date:</th>
                                    <td class="text-dark fw-medium">@Model.EndDate.ToString("dddd, MMMM dd, yyyy")</td>
                                </tr>
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0">Total Duration:</th>
                                    <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">@Model.TotalDays Days</span></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless align-middle mb-0 small">
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0" style="width: 35%;">Submission Date:</th>
                                    <td class="text-muted">@Model.RequestDate.ToString("dddd, MMMM dd, yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <th class="text-secondary fw-semibold ps-0">Justification:</th>
                                    <td class="text-dark" style="white-space: pre-line;">@Model.Reason</td>
                                </tr>
                                @if (!string.IsNullOrEmpty(Model.DocumentUrl))
                                {
                                    <tr>
                                        <th class="text-secondary fw-semibold ps-0">Verification Link:</th>
                                        <td>
                                            <a href="@Model.DocumentUrl" target="_blank" class="btn btn-xs btn-outline-secondary bg-white text-dark shadow-sm px-2 py-1 rounded-2" style="font-size: 0.75rem;">
                                                <i class="fas fa-download text-accent me-1"></i> Open Attachment
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Authorization Lifecycle Trackers -->
        <div class="col-md-12">
            <div class="section-card shadow-sm">
                <div class="card-header">
                    <h2 class="m-0">
                        <i class="fas fa-check-double me-2 text-accent"></i>Approval Stage Verification
                    </h2>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        <!-- Head of Department Gate -->
                        <div class="col-md-6">
                            <div class="border rounded-2 p-3 text-center h-100 bg-white shadow-sm position-relative overflow-hidden">
                                <div class="position-absolute start-0 top-0 bottom-0" style="width: 4px; background-color: @(Model.DepartmentHeadApprovalDate.HasValue ? "#198754" : "#ffc107");"></div>
                                @if (Model.DepartmentHeadApprovalDate.HasValue)
                                {
                                    <i class="fas fa-check-circle text-success fa-2x mb-2"></i>
                                    <h6 class="text-success fw-bold small mb-1">Department Head Action</h6>
                                    <p class="text-muted mb-2" style="font-size: 0.75rem;">Verified: @Model.DepartmentHeadApprovalDate.Value.ToString("MMM dd, yyyy HH:mm")</p>
                                    @if (!string.IsNullOrEmpty(Model.DepartmentHeadComments))
                                    {
                                        <div class="bg-light border text-start rounded-1 p-2 mt-2 small text-secondary">
                                            <i class="fas fa-comment text-accent me-1"></i> @Model.DepartmentHeadComments
                                        </div>
                                    }
                                }
                                else
                                {
                                    <i class="fas fa-clock text-warning fa-2x mb-2"></i>
                                    <h6 class="text-warning fw-bold small mb-1">Department Head Action</h6>
                                    <p class="text-muted small mb-0">Awaiting management level update</p>
                                }
                            </div>
                        </div>

                        <!-- System Administrator Final Gate -->
                        <div class="col-md-6">
                            @{
                                var sideColor = !Model.AdminApprovalDate.HasValue ? "#ffc107" : (Model.Status == Take_Leave.Models.LeaveStatus.Approved ? "#198754" : "#dc3545");
                            }
                            <div class="border rounded-2 p-3 text-center h-100 bg-white shadow-sm position-relative overflow-hidden">
                                <div class="position-absolute start-0 top-0 bottom-0" style="width: 4px; background-color: @sideColor;"></div>
                                @if (Model.AdminApprovalDate.HasValue)
                                {
                                    if (Model.Status == Take_Leave.Models.LeaveStatus.Approved)
                                    {
                                        <i class="fas fa-check-circle text-success fa-2x mb-2"></i>
                                        <h6 class="text-success fw-bold small mb-1">Executive Administration</h6>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-danger fa-2x mb-2"></i>
                                        <h6 class="text-danger fw-bold small mb-1">Executive Administration</h6>
                                    }
                                    <p class="text-muted mb-2" style="font-size: 0.75rem;">Processed: @Model.AdminApprovalDate.Value.ToString("MMM dd, yyyy HH:mm")</p>
                                    @if (!string.IsNullOrEmpty(Model.AdminComments))
                                    {
                                        <div class="bg-light border text-start rounded-1 p-2 mt-2 small text-secondary">
                                            <i class="fas fa-comment text-accent me-1"></i> @Model.AdminComments
                                        </div>
                                    }
                                }
                                else
                                {
                                    <i class="fas fa-clock text-warning fa-2x mb-2"></i>
                                    <h6 class="text-warning fw-bold small mb-1">Executive Administration</h6>
                                    <p class="text-muted small mb-0">Pending administrative processing sequence</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contextual Alert States System -->
        <div class="col-md-12">
            @if (Model.Status == Take_Leave.Models.LeaveStatus.Approved)
            {
                <div class="alert bg-success-subtle text-success border border-success-subtle p-3 rounded-2 shadow-sm mb-0">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fas fa-chart-line"></i>
                        <strong class="small text-uppercase tracking-wider fw-bold">Updated Account Balance Ledger</strong>
                    </div>
                    <div class="row g-2 text-dark small">
                        <div class="col-sm-4">Annual Remainder: <strong class="text-success">@Model.User?.AnnualLeaveBalance Days</strong></div>
                        <div class="col-sm-4">Sick Remainder: <strong class="text-success">@Model.User?.SickLeaveBalance Days</strong></div>
                        <div class="col-sm-4">Emergency Remainder: <strong class="text-success">@Model.User?.EmergencyLeaveBalance Days</strong></div>
                    </div>
                </div>
            }
            else if (Model.Status == Take_Leave.Models.LeaveStatus.Pending || Model.Status == Take_Leave.Models.LeaveStatus.ApprovedByDepartmentHead)
            {
                <div class="alert bg-warning-subtle text-warning-emphasis border border-warning-subtle p-3 rounded-2 shadow-sm mb-0 small">
                    <i class="fas fa-hourglass-half me-2"></i>
                    <strong>Pending Action:</strong> This operational leave request entry is locked under the current validation gate sequence.
                </div>
            }
        </div>
    </div>
}
else
{
    <!-- Unified Flat Warning Container -->
    <div class="text-center p-5 border border-dashed rounded-3 bg-light my-4">
        <i class="fas fa-folder-open text-danger mb-3" style="font-size: 2.5rem;"></i>
        <h5 class="text-dark fw-semibold mb-1">Target Resource Not Found</h5>
        <p class="text-muted small mb-0">The specified leave application reference logs could not be found or pulled by the data layout engine.</p>
    </div>
}