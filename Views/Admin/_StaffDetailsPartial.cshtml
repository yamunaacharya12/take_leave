@model Take_Leave.Models.ApplicationUser

@if (Model != null)
{
    <div class="row g-4">
        <div class="col-md-12">
            <div class="d-flex align-items-center gap-3 border-bottom pb-3 mb-2">
                <div class="bg-light border text-dark d-flex align-items-center justify-content-center rounded-2" style="width: 54px; height: 54px; font-size: 1.25rem;">
                    <i class="fas fa-id-badge text-accent"></i>
                </div>
                <div>
                    <h3 class="text-dark fw-bold m-0" style="font-size: 1.25rem;">@Model.FullName</h3>
                    <div class="d-flex align-items-center gap-2 mt-1 small">
                        <span class="text-secondary fw-medium">@Model.Designation</span>
                        <span class="text-muted">•</span>
                        <span class="badge bg-light text-dark border px-2 py-0.5 small fw-semibold">@Model.EmployeeId</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="section-card shadow-sm h-100">
                <div class="card-header">
                    <h2 class="m-0">
                        <i class="fas fa-briefcase me-2 text-accent"></i>Employment Assignment
                    </h2>
                </div>
                <div class="card-body p-3">
                    <table class="table table-borderless align-middle mb-0 small">
                        <tr>
                            <th class="text-secondary fw-semibold ps-0" style="width: 35%;">Institutional ID:</th>
                            <td class="text-dark fw-bold">@Model.EmployeeId</td>
                        </tr>
                        <tr>
                            <th class="text-secondary fw-semibold ps-0">Department Unit:</th>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">@Model.Department</span></td>
                        </tr>
                        <tr>
                            <th class="text-secondary fw-semibold ps-0">Official Title:</th>
                            <td class="text-dark">@Model.Designation</td>
                        </tr>
                        <tr>
                            <th class="text-secondary fw-semibold ps-0">Access Authority:</th>
                            <td class="text-secondary fw-medium">
                                @(Model.UserRole == UserRole.Admin ? "Administrator" : Model.UserRole == UserRole.DepartmentHead ? "Department Head" : "Staff Member")
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="section-card shadow-sm h-100">
                <div class="card-header">
                    <h2 class="m-0">
                        <i class="fas fa-shield-alt me-2 text-accent"></i>Account Logs & Status
                    </h2>
                </div>
                <div class="card-body p-3">
                    <table class="table table-borderless align-middle mb-0 small">
                        <tr>
                            <th class="text-secondary fw-semibold ps-0" style="width: 35%;">Email Address:</th>
                            <td><a href="mailto:@Model.Email" class="text-decoration-none text-primary fw-medium">@Model.Email</a></td>
                        </tr>
                        <tr>
                            <th class="text-secondary fw-semibold ps-0">Joining Tenure:</th>
                            <td class="text-dark">@Model.JoiningDate.ToString("MMMM dd, yyyy")</td>
                        </tr>
                        <tr>
                            <th class="text-secondary fw-semibold ps-0">System Logins:</th>
                            <td class="text-muted">
                                <i class="fas fa-history small me-1"></i>
                                @(Model.LastLoginDate?.ToString("MMM dd, yyyy HH:mm") ?? "No tracking sequence active")
                            </td>
                        </tr>
                        <tr>
                            <th class="text-secondary fw-semibold ps-0">Lifecycle Status:</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold">ACTIVE PIPELINE</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-bold">DEACTIVATED</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center p-5 border border-dashed rounded-3 bg-light my-4">
        <i class="fas fa-user-slash text-danger mb-3" style="font-size: 2.5rem;"></i>
        <h5 class="text-dark fw-semibold mb-1">Staff Member Obsolete</h5>
        <p class="text-muted small mb-0">The targeted administrative identity dataset cannot be verified or parsed by the portal runtime.</p>
    </div>
}