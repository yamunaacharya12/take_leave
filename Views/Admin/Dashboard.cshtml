@model Take_Leave.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-tachometer-alt" style="color:var(--primary);"></i> Admin Dashboard</h1>
        <p>Overview of staff, leave activity, and pending approvals</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card navy">
            <div class="accent-bar"></div>
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">TOTAL STAFF</div>
                    <div class="stat-value">@Model.TotalStaff</div>
                </div>
                <div class="icon-wrap"><i class="fas fa-users"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card gold">
            <div class="accent-bar"></div>
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">PENDING LEAVES</div>
                    <div class="stat-value">@Model.PendingLeavesCount</div>
                </div>
                <div class="icon-wrap"><i class="fas fa-clock"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card pink">
            <div class="accent-bar"></div>
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">PENDING REGISTRATIONS</div>
                    <div class="stat-value">@Model.PendingRegistrationsCount</div>
                </div>
                <div class="icon-wrap"><i class="fas fa-user-plus"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card green">
            <div class="accent-bar"></div>
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">APPROVED THIS MONTH</div>
                    <div class="stat-value">@Model.ApprovedLeavesThisMonth</div>
                    <div class="stat-sub">of @Model.TotalLeavesThisMonth total this month</div>
                </div>
                <div class="icon-wrap"><i class="fas fa-check-circle"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="section-card">
    <div class="card-header">
        <h2><i class="fas fa-user-clock me-1"></i> Pending Registrations</h2>
        <a asp-action="StaffList" style="font-size:12.5px; color:var(--primary); font-weight:600; text-decoration:none;">View All Staff <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
    <div class="card-body p-0">
        @if (Model.PendingRegistrations != null && Model.PendingRegistrations.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Employee ID</th>
                            <th>Department</th>
                            <th>Registered</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.PendingRegistrations)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.EmployeeId</td>
                                <td>@(user.Department?.Name ?? "—")</td>
                                <td>@user.RegistrationDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    <form asp-action="ApproveUser" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <i class="fas fa-check me-1"></i> Approve
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-user-check"></i>
                No pending registrations right now.
            </div>
        }
    </div>
</div>

<div class="section-card">
    <div class="card-header">
        <h2><i class="fas fa-file-alt me-1"></i> Pending Leave Requests</h2>
        <a asp-action="AllLeaveRequests" style="font-size:12.5px; color:var(--primary); font-weight:600; text-decoration:none;">View All Requests <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
    <div class="card-body p-0">
        @if (Model.PendingLeaves != null && Model.PendingLeaves.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Staff</th>
                            <th>Type</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in Model.PendingLeaves)
                        {
                            <tr>
                                <td>@leave.User?.FullName</td>
                                <td>@leave.LeaveType</td>
                                <td>@leave.StartDate.ToString("MMM d, yyyy")</td>
                                <td>@leave.EndDate.ToString("MMM d, yyyy")</td>
                                <td>@leave.TotalDays</td>
                                <td>
                                    <span class="status-badge @(leave.Status == Take_Leave.Models.LeaveStatus.ApprovedByDepartmentHead ? "status-head-approved" : "status-pending")">
                                        @leave.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <form asp-action="ApproveLeave" method="post" class="d-inline">
                                            <input type="hidden" name="leaveId" value="@leave.Id" />
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                        <form asp-action="RejectLeave" method="post" class="d-inline">
                                            <input type="hidden" name="leaveId" value="@leave.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-clipboard-check"></i>
                No pending leave requests right now.
            </div>
        }
    </div>
</div>
